generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "cjs"
  runtime             = "nodejs"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AuthProvider {
  PASSWORD
  PHONE_OTP
  GOOGLE
  APPLE
}

enum RoleScope {
  GLOBAL
  BRANCH
}

model User {
  id     String     @id @default(uuid()) @db.Uuid
  status UserStatus @default(PENDING_VERIFICATION)

  firstName String? @map("first_name") @db.VarChar(100)
  lastName  String? @map("last_name") @db.VarChar(100)
  phone     String? @db.VarChar(32)

  lastLoginAt DateTime? @map("last_login_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  authIdentities  AuthIdentity[]
  roleAssignments UserRoleAssignment[]
  sessions        Session[]

  @@index([status])
  @@map("users")
}

model AuthIdentity {
  id       String       @id @default(uuid()) @db.Uuid
  userId   String       @map("user_id") @db.Uuid
  provider AuthProvider

  identifier   String  @db.VarChar(320)
  passwordHash String? @map("password_hash") @db.Text

  verifiedAt DateTime? @map("verified_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@unique([provider, identifier])
  @@index([userId])
  @@map("auth_identities")
}

model Role {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(64)
  name        String  @db.VarChar(100)
  description String? @db.Text
  isSystem    Boolean @default(false) @map("is_system")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  permissions RolePermission[]
  assignments UserRoleAssignment[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(100)
  name        String  @db.VarChar(120)
  description String? @db.Text

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String   @map("role_id") @db.Uuid
  permissionId String   @map("permission_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@index([permissionId])
  @@map("role_permissions")
}

model Branch {
  id   String @id @default(uuid()) @db.Uuid
  code String @unique @db.VarChar(20)
  name String @db.VarChar(150)

  addressLine1 String? @map("address_line_1") @db.VarChar(200)
  addressLine2 String? @map("address_line_2") @db.VarChar(200)
  suburb       String? @db.VarChar(100)
  stateCode    String? @map("state_code") @db.VarChar(3)
  postcode     String? @db.VarChar(10)

  countryCode String @default("AU") @map("country_code") @db.Char(2)
  timezone    String @default("Australia/Brisbane") @db.VarChar(64)

  phone String? @db.VarChar(32)
  email String? @db.VarChar(320)

  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  roleAssignments UserRoleAssignment[]

  @@index([isActive])
  @@index([stateCode])
  @@map("branches")
}

model UserRoleAssignment {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  scope    RoleScope
  branchId String?   @map("branch_id") @db.Uuid

  assignedAt DateTime  @default(now()) @map("assigned_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  role Role @relation(fields: [roleId], references: [id], onDelete: Restrict)

  branch Branch? @relation(fields: [branchId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([roleId])
  @@index([branchId])
  @@index([userId, roleId, branchId])
  @@map("user_role_assignments")
}

model Session {
  id String @id @default(uuid()) @db.Uuid

  userId String @map("user_id") @db.Uuid

  refreshTokenHash String @unique @map("refresh_token_hash") @db.Text

  deviceId   String? @map("device_id") @db.VarChar(255)
  deviceName String? @map("device_name") @db.VarChar(255)
  userAgent  String? @map("user_agent") @db.Text
  ipAddress  String? @map("ip_address") @db.Inet

  expiresAt  DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastUsedAt DateTime? @map("last_used_at") @db.Timestamptz(3)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@index([deviceId])
  @@map("sessions")
}

enum VehicleStatus {
  DRAFT
  AVAILABLE
  RESERVED
  SOLD
  REMOVED
}

enum MediaType {
  PHOTO
  VIDEO
}

model Vehicle {
  id String @id @default(uuid()) @db.Uuid

  stockNumber String? @unique @map("stock_number") @db.VarChar(50)

  vin String? @unique @db.VarChar(100)

  lotNumber String? @map("lot_number") @db.VarChar(100)

  auctionName String? @map("auction_name") @db.VarChar(150)

  make  String @db.VarChar(100)
  model String @db.VarChar(100)
  year  Int

  vehicleType String? @map("vehicle_type") @db.VarChar(50)

  condition String? @db.VarChar(50)

  primaryDamage   String? @map("primary_damage") @db.VarChar(100)
  secondaryDamage String? @map("secondary_damage") @db.VarChar(100)

  color String? @db.VarChar(50)

  transmission String? @db.VarChar(50)

  fuel String? @db.VarChar(50)

  odometer Int?

  cylinders Int?

  engineType String? @map("engine_type") @db.VarChar(100)

  drivetrain String? @db.VarChar(100)

  price Decimal? @db.Decimal(12, 2)

  status VehicleStatus @default(DRAFT)

  media VehicleMedia[]

  attributes VehicleAttribute[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status])
  @@index([make, model])
  @@map("vehicles")
}

model VehicleMedia {
  id String @id @default(uuid()) @db.Uuid

  vehicleId String @map("vehicle_id") @db.Uuid

  type MediaType

  url String @db.Text

  storageKey String @map("storage_key") @db.Text

  position Int @default(0)

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([vehicleId])
  @@map("vehicle_media")
}

model VehicleAttribute {
  id String @id @default(uuid()) @db.Uuid

  vehicleId String @map("vehicle_id") @db.Uuid

  key String @db.VarChar(100)

  value String @db.Text

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([vehicleId])
  @@map("vehicle_attributes")
}

model VehicleSequence {
  id String @id @default(uuid()) @db.Uuid

  year Int @unique

  lastNumber Int @default(0) @map("last_number")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("vehicle_sequences")
}
